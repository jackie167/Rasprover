<?xml version="1.0"?>
<package format="3">
  <name>rasprover_slam</name>
  <version>0.0.1</version>
  <description>Blueprint-aligned ROS 2 SLAM package for Rasprover configs and launches.</description>

  <maintainer email="thi.ledinh@gmail.com">jackie167</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rasprover_base</exec_depend>
  <exec_depend>rasprover_control</exec_depend>
  <exec_depend>rasprover_sensors</exec_depend>
  <exec_depend>rasprover_ui</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
